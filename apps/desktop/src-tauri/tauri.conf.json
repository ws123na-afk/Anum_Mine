{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ANUM",
  "version": "0.1.0",
  "identifier": "dev.anum.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../../web dev",
    "beforeBuildCommand": "pnpm --dir ../../web build"
  },
  "app": {
    "windows": [
      {
        "title": "ANUM",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
