<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Code-signing entitlements of the macOS app (docs/desktop.md, "Microphone"). The hardened
     runtime that notarization requires blocks the microphone unless this entitlement is present;
     calls through ANUM (docs/calls.md#browser-calls) need it. Nothing else is asked for. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
