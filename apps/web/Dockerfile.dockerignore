# Build context for apps/web/Dockerfile is the repository root. BuildKit reads this file
# instead of a root .dockerignore. Only the web app, contracts and workspace manifests
# are sent; local secrets and other apps never enter the context.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!apps/desktop/package.json
!apps/web
!packages/contracts
**/node_modules
**/dist
**/.env
**/.env.*
apps/web/e2e
apps/web/playwright-report
apps/web/test-results
