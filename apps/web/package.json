{
  "name": "@anum/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build",
    "check": "tsc -p tsconfig.json --noEmit && pnpm run test:unit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "node --experimental-strip-types --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@anum/contracts": "workspace:*",
    "@vitejs/plugin-react": "latest",
    "kokoro-js": "1.2.1",
    "lucide-react": "latest",
    "ogl": "^1.0.11",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "^7.0.2",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
