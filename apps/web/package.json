{
  "name": "@anum/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build",
    "check": "tsc -p tsconfig.json --noEmit && pnpm run test:unit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "node --experimental-strip-types --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@anum/contracts": "workspace:*",
    "@sentry/browser": "11.9.0",
    "@twilio/voice-sdk": "2.18.5",
    "@vitejs/plugin-react": "6.1.2",
    "kokoro-js": "1.2.1",
    "lucide-react": "1.61.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.184.0",
    "typescript": "^7.0.2",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.184.0"
  }
}
