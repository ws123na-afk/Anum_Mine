VITE_ANUM_API_URL=http://localhost:8000

# Keycloak sign-in (authorization code + PKCE). Leave VITE_ANUM_OIDC_ISSUER empty to keep the
# local development session (API in ANUM_AUTH_MODE=headers). See docs/identity.md.
VITE_ANUM_OIDC_ISSUER=
# anum-web for the browser; anum-desktop for the Tauri shell.
VITE_ANUM_OIDC_CLIENT_ID=anum-web
# Optional: workspace sent as x-workspace-id when the token has no workspace_id claim.
VITE_ANUM_WORKSPACE_ID=
