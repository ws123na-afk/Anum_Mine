# ANUM local defaults, matching infra/docker/compose.yaml's services.
# Every variable name here is a real anum_api/settings.py field
# (ANUM_<FIELD_NAME>, uppercased) - see docs/deployment.md's settings
# table for what each one does. None of these are required: every one
# defaults to off/local-in-memory behavior when unset, so a bare
# `uvicorn --reload` with no .env file at all still works.

ANUM_ENVIRONMENT=local
ANUM_DATABASE_URL=postgresql+psycopg://anum:anum@localhost:5432/anum
ANUM_REPOSITORY_BACKEND=memory
ANUM_KEYCLOAK_ISSUER=http://localhost:8080/realms/anum

# Phase 2 boundaries - uncomment to exercise them locally against
# `docker compose -f infra/docker/compose.yaml up`.
# ANUM_VALKEY_URL=redis://localhost:6379/0
# ANUM_NATS_URL=nats://localhost:4222
# ANUM_TEMPORAL_ADDRESS=localhost:7233
# ANUM_OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
# ANUM_OBJECT_STORAGE_BUCKET=anum-files
# ANUM_OBJECT_STORAGE_ACCESS_KEY=anum
# ANUM_OBJECT_STORAGE_SECRET_KEY=anum-local-secret

# Real model calls instead of the deterministic mock gateway.
# ANUM_MODEL_PROVIDER=anthropic
# ANUM_ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY
