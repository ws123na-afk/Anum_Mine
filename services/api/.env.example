ANUM_ENVIRONMENT=local
ANUM_DATABASE_URL=postgresql+psycopg://anum:anum@localhost:5432/anum
ANUM_REPOSITORY_BACKEND=memory
ANUM_KEYCLOAK_ISSUER=http://localhost:8080/realms/anum
# headers (local/test only) or oidc
ANUM_AUTH_MODE=headers
ANUM_OIDC_AUDIENCE=anum-api
ANUM_OIDC_JWKS_URL=
ANUM_CORS_ORIGINS=["http://localhost:5173"]
ANUM_MODEL_PROVIDER=mock
# Free local model (Ollama, no API key): install Ollama, run `ollama pull llama3.2`
# and `ollama serve`, then uncomment these (the API is OpenAI-compatible).
# ANUM_MODEL_PROVIDER=ollama
# ANUM_MODEL_NAME=llama3.2
# ANUM_MODEL_BASE_URL=http://localhost:11434/v1
ANUM_EVENT_BUS=memory
ANUM_NATS_URL=nats://localhost:4222
