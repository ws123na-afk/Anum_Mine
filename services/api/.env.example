ANUM_ENVIRONMENT=local
ANUM_DATABASE_URL=postgresql+psycopg://anum:anum@localhost:5432/anum
ANUM_REPOSITORY_BACKEND=memory
ANUM_KEYCLOAK_ISSUER=http://localhost:8080/realms/anum
# headers (local/test only) or oidc
ANUM_AUTH_MODE=headers
ANUM_OIDC_AUDIENCE=anum-api
ANUM_OIDC_JWKS_URL=
ANUM_CORS_ORIGINS=["http://localhost:5173"]
ANUM_MODEL_PROVIDER=mock
# Free local model (Ollama, no API key): install Ollama, run `ollama pull llama3.2`
# and `ollama serve`, then uncomment these (the API is OpenAI-compatible).
# ANUM_MODEL_PROVIDER=ollama
# ANUM_MODEL_NAME=llama3.2
# ANUM_MODEL_BASE_URL=http://localhost:11434/v1
ANUM_EVENT_BUS=memory
ANUM_NATS_URL=nats://localhost:4222
# Gateway retries (timeouts, connection errors, 429, 5xx) and per-attempt timeout.
ANUM_MODEL_MAX_ATTEMPTS=3
ANUM_MODEL_TIMEOUT_SECONDS=60
# Optional price table (USD per 1M tokens) for estimated_cost_usd, as JSON:
# ANUM_MODEL_PRICES={"gpt-4.1-mini": {"input_per_million": 0.4, "output_per_million": 1.6}}
# Outside local/test, workspace model base URLs must be public HTTPS on port 443
# (SSRF guard, docs/model-gateway.md). Allow a self-hosted model on a private network
# explicitly with comma-separated host or host:port entries:
# ANUM_MODEL_ALLOWED_HOSTS=ollama.internal:11434
# Retrieval of workspace memories and files into task prompts (docs/memory.md#retrieval).
# "gateway" embeds through the workspace's model (budgets and the SSRF guard apply; the
# mock provider uses the deterministic local embedder); "local" never calls a model.
# ANUM_EMBEDDING_BACKEND=gateway
# ANUM_EMBEDDING_MODEL=                  # empty: nomic-embed-text (Ollama) or text-embedding-3-small
# ANUM_RETRIEVAL_TOP_K=5                 # 0 turns retrieval off
# ANUM_RETRIEVAL_MAX_CHARS=6000
# ANUM_RETRIEVAL_BLOCK_MAX_CHARS=1500
# Conversation memory (docs/memory.md#from-conversations): remember durable facts the user
# states in the assistant chat, and recall them into later chats.
# ANUM_CONVERSATION_MEMORY_ENABLED=true   # false: no extraction and no recall
# ANUM_CONVERSATION_MEMORY_MAX_TOKENS=256
# ANUM_CONVERSATION_MEMORY_RECALL_K=4      # 0 turns recall off
# ANUM_CONVERSATION_MEMORY_RECALL_CHARS=2000
# Fernet key(s) encrypting stored provider API keys. Required outside local; generate with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ANUM_SECRETS_KEY=
# HTTP hardening (docs/security.md). Outside ANUM_ENVIRONMENT=local the API refuses
# localhost/wildcard CORS origins and the compose default credentials.
# ANUM_MAX_REQUEST_BODY_BYTES=1048576
# ANUM_MAX_UPLOAD_BODY_BYTES=26214400
# Workspace files (docs/files.md): total bytes per workspace and signed link lifetime.
# ANUM_FILES_WORKSPACE_QUOTA_BYTES=2147483648
# ANUM_FILES_LINK_TTL_SECONDS=300
# ANUM_RATE_LIMIT_ENABLED=true
# ANUM_RATE_LIMIT_REQUESTS_PER_MINUTE=600
# ANUM_RATE_LIMIT_BURST=120
# Stage 3 adapters (docs/agent-runtime.md, docs/files.md), all off by default.
# ANUM_RUNTIME_BACKEND=inline            # or temporal (run `python -m anum_api.worker`)
# ANUM_TEMPORAL_TARGET=localhost:7233
# ANUM_TEMPORAL_NAMESPACE=default
# ANUM_TEMPORAL_TASK_QUEUE=anum-agent-runs
# ANUM_APPROVAL_TTL_SECONDS=86400       # pending approvals expire after 24 hours
# ANUM_CONVERSATION_RETENTION_DAYS=30   # retention job deletes conversations idle this long; 0 keeps them
# ANUM_PRIVACY_POLICY_URL=               # public privacy policy link shown on the Privacy page (docs/privacy.md)
# ANUM_PRIVACY_EXPORT_MAX_BYTES=26214400 # largest "Download my data" export; larger ones are refused with 413
# ANUM_TOOL_RESPONSE_MAX_BYTES=262144    # integration responses are cut here (marked truncated)
# Private web search through a self-hosted SearXNG (docs/tools-and-integrations.md#web-search).
# Empty: the web_search tool is off. Compose containers reach it as http://searxng:8080.
# ANUM_SEARXNG_URL=
# ANUM_WEB_SEARCH_TIMEOUT_SECONDS=8
# ANUM_WEB_SEARCH_MAX_RESULTS=5
# ANUM_WEB_SEARCH_SAFE_SEARCH=1          # 0 off, 1 moderate, 2 strict
# Phone calls (docs/calls.md). Free tel: calling needs nothing. Provider calls need the public
# https origin the voice provider calls back; credentials are entered by an owner in the app.
# ANUM_CALLS_PUBLIC_BASE_URL=            # e.g. https://api.example.com
# ANUM_CALLS_AI_MAX_SECONDS=600
# ANUM_CALLS_AI_MAX_COST_CENTS=500
# Calls & Meetings (docs/meetings.md). Transcription: none, openai-compatible (local Whisper
# server or hosted API) or deepgram. Zoom/Teams connectors stay off without their OAuth apps.
# ANUM_TRANSCRIPTION_PROVIDER=none
# ANUM_TRANSCRIPTION_BASE_URL=           # e.g. http://whisper:8000/v1
# ANUM_TRANSCRIPTION_MODEL=
# ANUM_TRANSCRIPTION_API_KEY=
# ANUM_MEETING_RECORDING_MAX_BYTES=26214400
# ANUM_MEETING_TRANSCRIPT_MAX_BYTES=5242880
# ANUM_MEETINGS_OAUTH_REDIRECT_URI=      # e.g. https://app.example.com/meetings/connected
# ANUM_ZOOM_CLIENT_ID=
# ANUM_ZOOM_CLIENT_SECRET=
# ANUM_MICROSOFT_CLIENT_ID=
# ANUM_MICROSOFT_CLIENT_SECRET=
# ANUM_MICROSOFT_TENANT=organizations
# ANUM_VALKEY_URL=redis://localhost:6379/0
# ANUM_RUN_LOCK_BACKEND=none             # or valkey
# ANUM_RATE_LIMIT_BACKEND=memory         # or valkey
# ANUM_OBJECT_STORAGE_BACKEND=local      # or memory, s3
# ANUM_S3_ENDPOINT=http://localhost:9000
# ANUM_S3_BUCKET=anum-local
# ANUM_S3_ACCESS_KEY=
# ANUM_S3_SECRET_KEY=
# ANUM_S3_SERVER_SIDE_ENCRYPTION=
# ANUM_S3_CREATE_BUCKET=false
# Automation scheduler (docs/automation.md#scheduler), off by default. Safe on every
# replica with PostgreSQL; the API login needs the anum_maintenance role.
# ANUM_AUTOMATION_SCHEDULER_ENABLED=false
# ANUM_AUTOMATION_SCHEDULER_POLL_SECONDS=30
# ANUM_AUTOMATION_SCHEDULER_BATCH_SIZE=100
# Team work reminders run with the automation scheduler (docs/team-work.md#reminders).
# ANUM_TEAM_REMINDER_POLL_SECONDS=60
# ANUM_TEAM_REMINDER_BATCH_SIZE=200
# Team notification email (docs/team-work.md#notifications); the password belongs in the secret store.
# ANUM_SMTP_HOST=
# ANUM_SMTP_PORT=587
# ANUM_SMTP_SECURITY=starttls
# ANUM_SMTP_USERNAME=
# ANUM_SMTP_PASSWORD=
# ANUM_SMTP_FROM=
# Email Center (docs/email.md#email-center): own mail server over IMAPS and SMTP. Off by default.
# ANUM_MAILSERVER_ENABLED=false
# ANUM_MAILSERVER_IMAP_HOST=
# ANUM_MAILSERVER_IMAP_PORT=993
# ANUM_MAILSERVER_SMTP_HOST=
# ANUM_MAILSERVER_SMTP_PORT=587
# ANUM_MAILSERVER_SMTP_SECURITY=starttls
# ANUM_MAILSERVER_ALLOWED_DOMAINS=anum360os.com
# ANUM_MAILSERVER_ALLOWED_TENANTS=
# Optional read-only Mailcow API for the platform operator's mail health view. Off by default;
# use a Mailcow read-only API key and keep it in your secret store, never in git.
# ANUM_MAILCOW_API_ENABLED=false
# ANUM_MAILCOW_API_URL=
# ANUM_MAILCOW_API_KEY=
# Adding or removing mail domains and aliases from the platform console (always after an approval,
# docs/email.md#mail-domains): off by default; a separate Mailcow read-write key.
# ANUM_MAILCOW_WRITE_ENABLED=false
# ANUM_MAILCOW_API_WRITE_KEY=
# The host MX records must point to, and the timeout of each live DNS lookup.
# ANUM_MAILCOW_MAIL_HOST=
# ANUM_MAILCOW_DNS_TIMEOUT_SECONDS=3
# Developer mode (docs/developer-mode.md), off until the tenant is set. Owners add the
# repositories to build as projects in the Developer view, each with its own token (stored
# encrypted with ANUM_SECRETS_KEY) or the optional token below, a fine-grained GitHub token
# covering the selected repositories. Never commit a real value.
# ANUM_DEVELOPER_TENANT_ID=tenant_local
# ANUM_DEVELOPER_WORKSPACE_ID=
# ANUM_DEVELOPER_GITHUB_TOKEN=
# Before projects: the single repository; migration 0026 turns it into the first project.
# ANUM_DEVELOPER_GITHUB_REPO=owner/repo
# ANUM_DEVELOPER_MAX_REQUESTS_PER_DAY=10
# ANUM_DEVELOPER_MAX_PROJECTS=100
# ANUM_DEVELOPER_REQUEST_COST_USD=1.0
# Unified inbox (docs/email.md): the owner's OAuth clients. Never commit real values.
# ANUM_EMAIL_PUBLIC_API_URL=http://localhost:8000
# ANUM_EMAIL_WEB_URL=http://localhost:5173
# ANUM_EMAIL_GOOGLE_CLIENT_ID=
# ANUM_EMAIL_GOOGLE_CLIENT_SECRET=
# ANUM_EMAIL_MICROSOFT_CLIENT_ID=
# ANUM_EMAIL_MICROSOFT_CLIENT_SECRET=
# ANUM_EMAIL_MICROSOFT_TENANT=common
# ANUM_EMAIL_ZOHO_CLIENT_ID=
# ANUM_EMAIL_ZOHO_CLIENT_SECRET=
# ANUM_EMAIL_ZOHO_DATA_CENTRE=com
# ANUM_EMAIL_SYNC_INTERVAL_SECONDS=300
# Social media marketing (docs/marketing.md). One app per platform, created by the
# operator; a platform without its app shows what is missing. Placeholders only.
# ANUM_MARKETING_OAUTH_REDIRECT_URL=https://app.example.com/marketing/callback
# ANUM_MARKETING_PUBLIC_API_URL=https://api.example.com
# ANUM_MARKETING_META_APP_ID=
# ANUM_MARKETING_META_APP_SECRET=
# ANUM_MARKETING_LINKEDIN_CLIENT_ID=
# ANUM_MARKETING_LINKEDIN_CLIENT_SECRET=
# ANUM_MARKETING_X_CLIENT_ID=
# ANUM_MARKETING_X_CLIENT_SECRET=
# ANUM_MARKETING_TIKTOK_CLIENT_KEY=
# ANUM_MARKETING_TIKTOK_CLIENT_SECRET=
# ANUM_MARKETING_TIKTOK_DIRECT_POST=false
# ANUM_MARKETING_GOOGLE_CLIENT_ID=
# ANUM_MARKETING_GOOGLE_CLIENT_SECRET=
