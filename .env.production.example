# ANUM production template.
#
# Every value here is a placeholder or a documented default - copy this file,
# fill in the real values from your actual infrastructure/secret store, and
# never commit the filled-in copy. Field names match anum_api/settings.py
# exactly (ANUM_<FIELD_NAME>, uppercased) - see that file for the full list
# and docs/deployment.md for what each one does.
#
# .env.example (no ".production") is the broader, aspirational local-dev
# template covering the full target stack (Valkey/NATS/Temporal/S3) - most
# of those aren't real Settings fields yet. This file only lists what the
# API actually reads today.

ANUM_ENVIRONMENT=production
ANUM_APP_NAME="ANUM API"

# A real, network-reachable PostgreSQL instance. repository_backend must be
# postgresql in production - the in-memory backend loses all data on
# restart and is dev/test only.
ANUM_REPOSITORY_BACKEND=postgresql
ANUM_DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DB

# Real OIDC, not the stub headers. Point these at a real Keycloak realm
# provisioned from infra/docker/keycloak/anum-realm.production-template.json
# (see infra/docker/keycloak/README.md#production) - NOT the local
# anum-realm.json dev/test realm, which has known seeded passwords.
ANUM_AUTH_MODE=oidc
ANUM_KEYCLOAK_ISSUER=https://REPLACE_WITH_YOUR_KEYCLOAK_HOST/realms/anum
ANUM_OIDC_AUDIENCE=anum-api
# Leave ANUM_OIDC_JWKS_URL unset to derive it from ANUM_KEYCLOAK_ISSUER
# (standard Keycloak path), or set it explicitly if your IdP differs.

# Only your real deployed web app origin(s) - must be a JSON array. Never
# use "*" alongside credentials, and never leave the localhost default from
# .env.example in a production CORS list.
ANUM_CORS_ORIGINS=["https://REPLACE_WITH_YOUR_WEB_APP_HOST"]

# Single-process rate limiting (see anum_api/rate_limit.py - does not
# coordinate across multiple replicas). Tune to real expected traffic.
ANUM_RATE_LIMIT_ENABLED=true
ANUM_RATE_LIMIT_REQUESTS=120
ANUM_RATE_LIMIT_WINDOW_SECONDS=60
# Only set this to true if a trusted reverse proxy/load balancer sits in
# front of the API and sets X-Forwarded-For itself - otherwise it is
# spoofable by any client and defeats the limiter.
ANUM_RATE_LIMIT_TRUST_FORWARDED_FOR=false

# Only enable once this deployment is served over HTTPS end-to-end.
ANUM_SECURITY_HEADERS_HSTS_ENABLED=true
