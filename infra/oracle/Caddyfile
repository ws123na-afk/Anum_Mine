# Caddy for ANUM on one VM (infra/oracle/compose.yaml, docs/deploy-oracle.md).
#
# Three HTTPS sites with certificates from Let's Encrypt, issued and renewed by Caddy
# (HTTP-01 on port 80 or TLS-ALPN-01 on 443; the hostnames' DNS A records must point at
# the VM). Port 80 only answers ACME challenges and redirects to https.
#
# Forwarded headers: Caddy is the first hop from the internet, so it trusts no proxy
# (no `trusted_proxies`). Every upstream request gets X-Forwarded-For set to the peer
# address Caddy saw, replacing whatever a client sent, plus X-Forwarded-Proto/Host.
# The API (FORWARDED_ALLOW_IPS) and Keycloak (KC_PROXY_TRUSTED_ADDRESSES) accept those
# headers only from Caddy's fixed address 172.30.10.10. If a CDN or another proxy is
# ever put in front, list its ranges in `trusted_proxies` here, never `0.0.0.0/0`.
#
# Placeholders {$NAME} are read from the container's environment at start (set from
# infra/oracle/.env by compose). infra/oracle/smoke.sh checks the result from outside.

{
	email {$ACME_EMAIL}
	# HTTP/1.1 and HTTP/2 only: HTTP/3 would need UDP 443 in the Oracle security list.
	servers {
		protocols h1 h2
	}
}

(upstream_headers) {
	header_up X-Forwarded-For {remote_host}
	header_up X-Real-IP {remote_host}
}

(common) {
	header -Server
	log {
		output stdout
		format json
	}
}

{$ANUM_WEB_HOST} {
	import common
	reverse_proxy web:8080 {
		import upstream_headers
	}
}

{$ANUM_API_HOST} {
	import common
	# Streams (SSE) are passed through unbuffered.
	reverse_proxy api:8000 {
		import upstream_headers
		flush_interval -1
	}
}

{$ANUM_AUTH_HOST} {
	import common
	header Strict-Transport-Security "max-age=63072000"
	header ?X-Content-Type-Options nosniff
	# The address Caddy sees for the caller: what to put in the allow-list below, and
	# how infra/oracle/smoke.sh checks that Caddy sees real client addresses.
	@client_ip path /anum/client-ip
	header @client_ip Cache-Control no-store
	respond @client_ip "{remote_host}" 200
	# Keycloak's admin console, admin REST API and the master realm (where the admins
	# sign in) answer only callers in ANUM_KEYCLOAK_ADMIN_ALLOWED_IPS. Caddy is the
	# edge, so remote_ip is the TCP peer: the real client address (Docker publishes the
	# ports with NAT). compose.yaml turns the comma-separated list from .env into the
	# space-separated one Caddy reads, and an empty list into 0.0.0.0/32 ::/128, which
	# no TCP peer can have: the console is then closed to the internet and reached
	# through an SSH tunnel (docs/deploy-oracle.md#keycloak). A peer on the Docker
	# networks (172.30.0.0/16, for example traffic relayed by docker-proxy, which hides
	# the client) is never allowed, whatever the list says. Sign-in to ANUM
	# (/realms/anum/...) stays public.
	@admin_denied {
		path /admin /admin/* /realms/master /realms/master/*
		not {
			remote_ip {$ANUM_KEYCLOAK_ADMIN_ALLOWED_IPS}
			not remote_ip 172.30.0.0/16
		}
	}
	respond @admin_denied "Keycloak's admin console is not reachable from this address (docs/deploy-oracle.md#keycloak)" 403
	# Management endpoints stay on Keycloak's private port 9000; never proxy them.
	@management path /health /health/* /metrics /metrics/*
	respond @management 404
	reverse_proxy keycloak:8080 {
		import upstream_headers
	}
}
