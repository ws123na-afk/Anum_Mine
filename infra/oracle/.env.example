# ANUM on one VM: settings for infra/oracle/compose.yaml (docs/deploy-oracle.md).
#
# Placeholders only. Never put a real value in this file. On the server, install.sh (or
# `python3 infra/oracle/configure_env.py infra/oracle/.env`) copies it to
# infra/oracle/.env with mode 600 (gitignored), replaces every `generate-on-server` with
# a fresh random secret, and asks for every `replace-me` value. Copy the generated
# secrets into your password manager: the database, the Fernet key and the backup
# passphrase cannot be recovered from anywhere else.
#
# Values are written without quotes; a value that needs any (spaces, `$`) is written in
# single quotes by configure_env.py.

# --- Environment ------------------------------------------------------------------
# staging or production (the API refuses local/test settings in both).
ANUM_ENVIRONMENT=staging

# --- Public addresses (owner) -------------------------------------------------------
# Three hostnames whose DNS A records point at the VM's public IP: your own domain
# (app.example.com, api.example.com, auth.example.com) or three free DuckDNS names
# (anum-app-yourname.duckdns.org, ...). Host names only: no https://, no slash.
ANUM_WEB_HOST=app.replace-me.example
ANUM_API_HOST=api.replace-me.example
ANUM_AUTH_HOST=auth.replace-me.example
# Let's Encrypt account e-mail (expiry warnings). Your own address.
ACME_EMAIL=replace-me@replace-me.example
# Who may open Keycloak's admin console (/admin and the master realm) through Caddy:
# comma-separated addresses or CIDR ranges, for example your home IP as 203.0.113.7/32.
# Empty (the default): nobody from the internet; open the console through an SSH
# tunnel instead (docs/deploy-oracle.md#keycloak). Sign-in to ANUM (/realms/anum) is
# always public. install.sh refuses 0.0.0.0/0 and ::/0.
ANUM_KEYCLOAK_ADMIN_ALLOWED_IPS=

# --- Generated on the server (install.sh) -----------------------------------------
# PostgreSQL superuser `postgres`: db-init and the restore tools only.
ANUM_POSTGRES_PASSWORD=generate-on-server
# anum_migrator: schema owner, the migrate one-shot only.
ANUM_MIGRATOR_PASSWORD=generate-on-server
# anum_app: the API and the retention job (RLS applies).
ANUM_APP_PASSWORD=generate-on-server
# anum_relay: the outbox relay login, unused until NATS is added (created anyway).
ANUM_RELAY_PASSWORD=generate-on-server
# anum_backup: BYPASSRLS + pg_read_all_data, the backup job only.
ANUM_BACKUP_DB_PASSWORD=generate-on-server
# keycloak: Keycloak's own database login.
KEYCLOAK_DB_PASSWORD=generate-on-server
# Fernet key (url-safe base64, 44 characters) for stored provider keys. Comma-separated
# keys rotate it: new key first (docs/runbooks.md#rotating-anum_secrets_key).
ANUM_SECRETS_KEY=generate-on-server
# Keycloak's one-time bootstrap admin (master realm). Empty both values (keep the lines)
# after the day-one hardening in docs/deploy-oracle.md#keycloak.
KC_BOOTSTRAP_ADMIN_USERNAME=anum-bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=generate-on-server
# Encrypts the off-site backup copies on the VM before upload (rclone crypt). Without it
# the copies in the bucket cannot be read: keep it in your password manager.
ANUM_BACKUP_ENCRYPTION_PASSPHRASE=generate-on-server
# SearXNG's secret_key (private web search; signs its cookies). Used nowhere else.
SEARXNG_SECRET=generate-on-server

# --- Workspace files: S3-compatible bucket with versioning (owner) ------------------
# Backblaze B2: Buckets -> your bucket -> Endpoint, e.g. https://s3.us-west-004.backblazeb2.com
ANUM_S3_ENDPOINT=https://s3.replace-me.backblazeb2.com
# The region part of the endpoint, e.g. us-west-004.
ANUM_S3_REGION=replace-me
ANUM_S3_BUCKET=replace-me-files
# B2 Application Keys: a key for this bucket only, Read and Write (keyID / applicationKey).
ANUM_S3_ACCESS_KEY=replace-me
ANUM_S3_SECRET_KEY=replace-me

# --- Off-site backups: a second bucket, its own key (owner) -------------------------
# Can be in the same B2 account (free tier: 10 GB in total). Key: this bucket only,
# without deleteFiles; old copies expire through the bucket's lifecycle rule.
ANUM_BACKUP_S3_ENDPOINT=https://s3.replace-me.backblazeb2.com
ANUM_BACKUP_S3_REGION=replace-me
ANUM_BACKUP_S3_BUCKET=replace-me-backups
ANUM_BACKUP_S3_ACCESS_KEY=replace-me
ANUM_BACKUP_S3_SECRET_KEY=replace-me
# Local dumps on the VM (created by install.sh, owned by uid 10001, mode 700) and how
# many days of them backup.sh keeps there.
ANUM_BACKUP_DIR=/var/lib/anum/backups
ANUM_BACKUP_LOCAL_KEEP_DAYS=7

# --- AI model -------------------------------------------------------------------------
# Default: the mock model (placeholder answers; not allowed in production).
# Local Ollama on the VM's CPU: set COMPOSE_PROFILES=ai and
#   ANUM_MODEL_PROVIDER=ollama
#   ANUM_MODEL_NAME=qwen2.5:3b          (the same as OLLAMA_MODEL)
#   ANUM_MODEL_BASE_URL=http://ollama:11434/v1
#   ANUM_MODEL_ALLOWED_HOSTS=ollama:11434
#   ANUM_MODEL_TIMEOUT_SECONDS=300
# A hosted OpenAI-compatible provider: ANUM_MODEL_PROVIDER=openai-compatible, its
# https base URL and model name, and ANUM_MODEL_API_KEY from the provider.
# Claude with prompt caching: ANUM_MODEL_PROVIDER=anthropic and ANUM_MODEL_API_KEY; keep
# ANUM_MODEL_NAME/ANUM_MODEL_BASE_URL below to get https://api.anthropic.com with
# claude-haiku-5-5 for quick replies and claude-sonnet-5-5 for planning
# (docs/model-gateway.md#model-routing). Empty route names keep ANUM_MODEL_NAME.
COMPOSE_PROFILES=
ANUM_MODEL_PROVIDER=mock
ANUM_MODEL_NAME=gpt-4.1-mini
ANUM_MODEL_BASE_URL=https://api.openai.com/v1
ANUM_MODEL_API_KEY=
ANUM_MODEL_ALLOWED_HOSTS=
ANUM_MODEL_TIMEOUT_SECONDS=60
ANUM_MODEL_FAST_NAME=
ANUM_MODEL_CAPABLE_NAME=
ANUM_MODEL_FAST_EFFORT=low
ANUM_MODEL_CAPABLE_EFFORT=
# Voice calls (docs/voice.md#call-mode). Camera answers: a vision model name for an
# OpenAI-compatible or Ollama provider (anthropic uses its fast model). Server speech is
# optional; empty = device speech only. Prices are charged to the model budget.
ANUM_MODEL_VISION_NAME=
ANUM_SPEECH_STT_BASE_URL=
ANUM_SPEECH_STT_API_KEY=
ANUM_SPEECH_STT_MODEL=
ANUM_SPEECH_STT_USD_PER_MINUTE=0
ANUM_SPEECH_TTS_BASE_URL=
ANUM_SPEECH_TTS_API_KEY=
ANUM_SPEECH_TTS_MODEL=
ANUM_SPEECH_TTS_VOICE_EN=
ANUM_SPEECH_TTS_VOICE_AR=
ANUM_SPEECH_TTS_USD_PER_MILLION_CHARS=0
OLLAMA_MODEL=qwen2.5:3b

# --- Optional -------------------------------------------------------------------------
# DuckDNS: your account token (duckdns.org, top of the page) and your subdomain names
# without .duckdns.org, comma-separated. When set, install.sh adds a timer that keeps
# their A records on the VM's public IP. Leave empty with your own domain.
DUCKDNS_TOKEN=
DUCKDNS_DOMAINS=
# true: a daily timer runs update.sh (git pull --ff-only, build, migrate, restart).
# Fine for staging; for production update by hand.
ANUM_AUTO_UPDATE=false

# --- Optional in-app calls (docs/in-app-calls.md) ------------------------------------
# Calls between teammates stay off until `bash infra/oracle/calls.sh enable` sets the
# addresses below, opens the ports in the host firewall, adds `calls` to COMPOSE_PROFILES
# and starts the coturn relay. Open the same ports in the Oracle security list first (the
# script prints them). ANUM_TURN_SECRET is coturn's shared secret: the API mints TURN
# credentials from it that expire (ANUM_CALLS_TURN_TTL_SECONDS, default 2 hours).
ANUM_TURN_SECRET=generate-on-server
ANUM_TURN_EXTERNAL_IP=
ANUM_TURN_PRIVATE_IP=
ANUM_TURN_MIN_PORT=49160
ANUM_TURN_MAX_PORT=49200
ANUM_CALLS_TURN_URLS=
ANUM_CALLS_STUN_URLS=
# true only to try calls without a relay (they fail behind strict firewalls).
ANUM_CALLS_ALLOW_STUN_ONLY=false

# --- Optional monitoring (docs/monitoring-oracle.md) --------------------------------
# Leave empty: `bash infra/oracle/monitoring.sh enable` asks for the hostnames and the
# basic-auth password, generates the secrets, fills these in and adds `monitoring` (and,
# once the Beszel agent is connected, `monitoring-agent`) to COMPOSE_PROFILES.
# Two more hostnames pointing at the VM (with DuckDNS: anum-monitor-yourname.duckdns.org
# and anum-errors-yourname.duckdns.org).
ANUM_MONITOR_HOST=
ANUM_ERRORS_HOST=
# Caddy basic auth in front of both UIs: a user name and the bcrypt hash of its
# password (never the password itself).
ANUM_MONITORING_BASIC_AUTH_USER=
ANUM_MONITORING_BASIC_AUTH_HASH=
# GlitchTip's Django secret key and its database login (db/glitchtip.sql).
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DB_PASSWORD=
# Days GlitchTip keeps error events.
GLITCHTIP_MAX_EVENT_LIFE_DAYS=30
# From the Beszel hub's "Add system" dialog (monitoring.sh agent).
BESZEL_AGENT_KEY=
BESZEL_AGENT_TOKEN=
BESZEL_SYSTEM_NAME=anum-vm
# The API's error reporting: http://<key>@glitchtip:8000/<project id> on the private
# network (monitoring.sh dsn), or any https Sentry-compatible DSN. Empty: off.
ANUM_SENTRY_DSN=
# Browser error reporting from the web app: the public DSN of a GlitchTip project for the
# browser, https://<key>@<ANUM_ERRORS_HOST>/<project id> (monitoring.sh web-dsn). Compiled
# into the web bundle, so changing it rebuilds the web image. Empty: off.
ANUM_WEB_SENTRY_DSN=
# Phone push (docs/notifications.md): the Firebase service account's JSON key on one line,
# in single quotes ('{"type":"service_account",...}'; `jq -c . key.json` prints it so).
# It carries a private key: keep this file private (configure_env.py keeps it 0600). Empty:
# push is off and the apps say so. The API refuses a value that is not such a key.
ANUM_FCM_SERVICE_ACCOUNT_JSON=

# Unified inbox (docs/email.md). Optional: each provider is off until its OAuth client
# id and secret are set. Create the clients in Google Cloud, Azure (Entra ID) and the Zoho
# API console with the redirect URI https://<ANUM_API_HOST>/api/v1/email/oauth/callback.
ANUM_EMAIL_GOOGLE_CLIENT_ID=
ANUM_EMAIL_GOOGLE_CLIENT_SECRET=
ANUM_EMAIL_MICROSOFT_CLIENT_ID=
ANUM_EMAIL_MICROSOFT_CLIENT_SECRET=
ANUM_EMAIL_MICROSOFT_TENANT=common
ANUM_EMAIL_ZOHO_CLIENT_ID=
ANUM_EMAIL_ZOHO_CLIENT_SECRET=
# com, eu, in, com.au, jp, ca, sa (Saudi Arabia) or com.cn: where the Zoho account lives.
ANUM_EMAIL_ZOHO_DATA_CENTRE=com
# Seconds between background syncs of connected mailboxes; 0 turns background sync off.
ANUM_EMAIL_SYNC_INTERVAL_SECONDS=300

# Owner integrations (docs/integrations-setup.md has the steps for each). All optional:
# an empty value keeps that integration "not set up" under Integrations > Connection setup.
# Notification email over SMTP (for example Zoho Mail, Google Workspace or Microsoft 365
# SMTP). starttls (port 587) or tls (port 465). The password is the mailbox's app password.
ANUM_SMTP_HOST=
ANUM_SMTP_PORT=587
ANUM_SMTP_SECURITY=starttls
ANUM_SMTP_USERNAME=
ANUM_SMTP_PASSWORD=
ANUM_SMTP_FROM=
# Invitation emails and notification emails use this sender (docs/notifications.md#email).
# Failed sends are retried (docs/team-work.md#notifications); the account's app password goes above.
# Email Center (docs/email.md#email-center): the workspace's own mail server (Mailcow) over
# IMAPS 993 and SMTP 587. Off until true; people connect their mailbox in the web app with
# a mailbox app password (never put a password here). ALLOWED_TENANTS: your tenant id.
ANUM_MAILSERVER_ENABLED=false
ANUM_MAILSERVER_IMAP_HOST=
ANUM_MAILSERVER_IMAP_PORT=993
ANUM_MAILSERVER_SMTP_HOST=
ANUM_MAILSERVER_SMTP_PORT=587
ANUM_MAILSERVER_SMTP_SECURITY=starttls
ANUM_MAILSERVER_ALLOWED_DOMAINS=anum360os.com
ANUM_MAILSERVER_ALLOWED_TENANTS=
# Optional read-only Mailcow API for the platform operator's mail health view (off by
# default). Create a read-only API key in Mailcow (System, Configuration, Access, API) limited
# to the API container's address, and put it here on the VM only.
ANUM_MAILCOW_API_ENABLED=false
ANUM_MAILCOW_API_URL=
ANUM_MAILCOW_API_KEY=
# Meeting recordings to text: none, openai-compatible (with a base URL such as
# https://api.openai.com/v1 or http://whisper:8000/v1) or deepgram (with an API key).
ANUM_TRANSCRIPTION_PROVIDER=none
ANUM_TRANSCRIPTION_BASE_URL=
ANUM_TRANSCRIPTION_MODEL=
ANUM_TRANSCRIPTION_API_KEY=
# Zoom and Microsoft Teams transcripts. Redirect URL to register in both apps:
# https://<ANUM_WEB_HOST>/meetings/connected (compose sets it from ANUM_WEB_HOST).
ANUM_ZOOM_CLIENT_ID=
ANUM_ZOOM_CLIENT_SECRET=
ANUM_MICROSOFT_CLIENT_ID=
ANUM_MICROSOFT_CLIENT_SECRET=
ANUM_MICROSOFT_TENANT=organizations
# Social media marketing apps. Redirect URL to register in every app:
# https://<ANUM_WEB_HOST>/marketing/callback (compose sets it from ANUM_WEB_HOST).
ANUM_MARKETING_META_APP_ID=
ANUM_MARKETING_META_APP_SECRET=
ANUM_MARKETING_LINKEDIN_CLIENT_ID=
ANUM_MARKETING_LINKEDIN_CLIENT_SECRET=
ANUM_MARKETING_X_CLIENT_ID=
ANUM_MARKETING_X_CLIENT_SECRET=
ANUM_MARKETING_TIKTOK_CLIENT_KEY=
ANUM_MARKETING_TIKTOK_CLIENT_SECRET=
# true only after TikTok's app audit approved Direct Post.
ANUM_MARKETING_TIKTOK_DIRECT_POST=false
ANUM_MARKETING_GOOGLE_CLIENT_ID=
ANUM_MARKETING_GOOGLE_CLIENT_SECRET=
# Sales channels (Amazon, Noon, your own store) sync on their own when true.
ANUM_COMMERCE_SYNC_ENABLED=false
# Read-only finance connections (exchange rates) sync in the background; false = "Sync now" only (docs/finance.md#sync).
ANUM_FINANCE_SYNC_ENABLED=false
# The outbound REST webhook (external.action, every call approved). Optional bearer key;
# a workspace owner can store its own token under Integrations instead.
ANUM_EXTERNAL_WEBHOOK_URL=
ANUM_EXTERNAL_WEBHOOK_API_KEY=
# Developer mode: your organization id (and optionally one workspace id) from
# Settings > Organization, and an optional fine-grained GitHub token.
ANUM_DEVELOPER_TENANT_ID=
ANUM_DEVELOPER_WORKSPACE_ID=
ANUM_DEVELOPER_GITHUB_TOKEN=

# WhatsApp (docs/whatsapp.md). Days of message history kept for workspaces that chose no
# retention of their own (0 keeps it); the daily retention job deletes older messages.
ANUM_WHATSAPP_MESSAGE_RETENTION_DAYS=0
# Sort new customer messages with the workspace's model as they arrive (true or false).
ANUM_WHATSAPP_TRIAGE_ON_ARRIVAL=true

# What ANUM learned (docs/learning.md): false stops new learning for everyone; feedback
# signals older than this many days (7 to 3650) are deleted.
ANUM_LEARNING_ENABLED=true
ANUM_LEARNING_SIGNAL_RETENTION_DAYS=180

# --- Sign-in options (docs/deploy-oracle.md#google-and-apple-sign-in) -----------------
# The published privacy policy (https). Shown on every client's Privacy page and accepted
# by every new account. Empty: the API uses the web host's own page,
# https://<ANUM_WEB_HOST>/legal/privacy (docs/legal-pages.md), which shows a DRAFT banner
# until ANUM_LEGAL_PUBLISHED lists it; keycloak-2fa.sh sign-up still needs a value here.
ANUM_PRIVACY_POLICY_URL=
# Legal pages (/legal/terms, privacy, dpa, aup, subprocessors) shown as published, without
# the DRAFT banner: comma-separated ids or all. Only after the owner and a lawyer approved
# the text in docs/legal and every {{PLACEHOLDER}} is filled in. Rebuild the web image after.
ANUM_LEGAL_PUBLISHED=
# Which "Continue with ..." buttons the sign-in screens show: google, apple or
# google,apple. Set it after `keycloak-2fa.sh google` / `apple` (its status prints the
# value), then `docker compose up -d api`. Empty: email sign-in only.
ANUM_SIGN_IN_PROVIDERS=
# true after `keycloak-2fa.sh sign-up` turned on Keycloak's own sign-up page.
ANUM_SELF_SIGN_UP=false
# Optional "Sign in with Apple" Keycloak extension: its release jar (https) and the
# jar's SHA-256. Changing them rebuilds the Keycloak image (`docker compose build keycloak`).
ANUM_KEYCLOAK_APPLE_PROVIDER_URL=
ANUM_KEYCLOAK_APPLE_PROVIDER_SHA256=
