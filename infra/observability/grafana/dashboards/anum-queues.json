{
  "uid": "anum-queues",
  "title": "ANUM events and runs: queue depth",
  "description": "Outbox backlog (unpublished canonical events), Temporal activity outcomes and run lock contention. Alerts: AnumOutboxBacklogStale, AnumOutboxBacklogLarge, AnumOutboxParkedEvents, AnumTemporalActivityFailures, AnumRunCoordinationUnavailable. Runbooks: docs/runbooks.md#outbox-backlog, #temporal-stuck-or-failing-runs.",
  "tags": [
    "anum"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(anum_http_server_request_duration_seconds_count, deployment_environment_name)",
          "refId": "env-var"
        },
        "definition": "label_values(anum_http_server_request_duration_seconds_count, deployment_environment_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "anum"
      ],
      "title": "ANUM dashboards",
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Event outbox",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Backlog",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(anum_outbox_backlog{deployment_environment_name=~\"$env\"})",
          "legendFormat": "Backlog",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 100
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
